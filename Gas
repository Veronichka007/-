slider_V.label.set_color('#e8e8ec'); slider_V.valtext.set_color('#e8e8ec')

ax_slider_E = fig.add_axes([0.75, 0.04, 0.2, 0.02])
slider_E = Slider(ax_slider_E, 'ε  ', 0.0, 3.0, valinit=EPS, color="#a855f7")
slider_E.label.set_color('#e8e8ec'); slider_E.valtext.set_color('#e8e8ec')

def apply_eps_visibility():
    vis = (MODE == "real")
    ax_slider_E.set_visible(vis)
    slider_E.set_active(vis)

def apply_slider_units():
    slider_L.label.set_text(f'Размер сосуда L, {u_L()}')
    slider_V.label.set_text(f'Ср. скорость, {u_VEL()}')
    slider_L.valtext.set_text(fmt_val(slider_L.val, conv_L, "").strip())
    slider_V.valtext.set_text(fmt_val(slider_V.val, conv_VEL, "").strip())

apply_eps_visibility()
apply_slider_units()

def clear_histories():
    press_hist.clear(); theory_hist.clear()
    vdw_trail_x.clear(); vdw_trail_y.clear()
    ax_press.set_xlim(0, 50)

def toggle_mode(event):
    global MODE, V_MEAN, V_MEAN_REAL
    MODE = "real" if MODE == "ideal" else "ideal"
    btn_mode.label.set_text(f'Режим:\n{MODE.upper()}')
    slider_V.set_val(V_MEAN_REAL if MODE == "real" else V_MEAN)
    apply_eps_visibility()
    
    if MODE == "ideal":
        redraw_isotherms()
        crit_pt.set_data([], [])
        crit_pt.set_visible(False)
        dynamic_iso_line.set_visible(False)
    else:
        redraw_isotherms()
        update_crit_pt_position()
        dynamic_iso_line.set_visible(True)
    apply_vdw_limits()
    apply_vdw_labels()
    update_eq_text()
    gas.reset()
    clear_histories()

def toggle_units(event):
    global USE_SI
    USE_SI = not USE_SI
    btn_units.label.set_text(f'Единицы: {"СИ" if USE_SI else "LJ"}')
    apply_vdw_limits()
    redraw_isotherms()
    apply_vdw_labels()
    update_crit_pt_position()
    apply_slider_units()
    clear_histories()

def reset_sim(event):
    gas.reset()
    clear_histories()

def update_L(val):
    global L
    rad = SIGMA * 0.5
    s = val / L if L > 1e-6 else 1.0
    c_old = L / 2.0
    c_new = val / 2.0
    gas.x = c_new + (gas.x - c_old) * s
    gas.y = c_new + (gas.y - c_old) * s
    L = val
    gas.x = np.clip(gas.x, rad, L - rad)
    gas.y = np.clip(gas.y, rad, L - rad)
    ax_box.set_xlim(0, L)
    ax_box.set_ylim(0, L)
    if MODE == "real":
        gas.compute_forces_lj()
    gas.reset_measurements()
    slider_L.valtext.set_text(fmt_val(val, conv_L, "").strip())

def update_V(val):
    global V_MEAN, V_MEAN_REAL
    current_v = np.mean(np.sqrt(gas.vx**2 + gas.vy**2))
    if current_v > 1e-5:
        factor = val / current_v
        gas.vx *= factor
        gas.vy *= factor
    if MODE == "ideal":
        V_MEAN = val
    else:
        V_MEAN_REAL = val
    gas.reset_measurements()
    slider_V.valtext.set_text(fmt_val(val, conv_VEL, "").strip())

def update_E(val):
    global EPS, S_space
    EPS = val
    update_vdw_constants()
    gas.reset_measurements()
    vdw_trail_x.clear(); vdw_trail_y.clear()

    S_space = iso_s_space()
    redraw_isotherms()

    apply_vdw_labels()
    update_crit_pt_position()
    update_eq_text()

btn_mode.on_clicked(toggle_mode)
btn_reset.on_clicked(reset_sim)
btn_units.on_clicked(toggle_units)
slider_L.on_changed(update_L)
slider_V.on_changed(update_V)
slider_E.on_changed(update_E)

def update(_):
    for _ in range(4): 
        gas.step()

    M = gas.measurements()

    scat.set_offsets(np.c_[gas.x, gas.y])
    v = np.sqrt(gas.vx ** 2 + gas.vy ** 2)
    t = np.clip(v / (V_MEAN * 2.0 if MODE=="ideal" else V_MEAN_REAL * 2.0), 0, 1)
    colors = np.zeros((N, 3))
    colors[:, 0] = 0.23 + 0.77 * t
    colors[:, 1] = 0.51 - 0.3 * np.abs(t - 0.5)
    colors[:, 2] = 0.96 - 0.8 * t
    colors = np.clip(colors + gas.flash[:, None] * 0.5, 0, 1)
    scat.set_color(colors)

    bbox = ax_box.get_window_extent()
    if bbox.width > 1:
        if MODE == "ideal":
            s_marker = IDEAL_MARKER_PX
        else:
            points_per_unit = (bbox.width / L) / (fig.dpi / 72.0)
            diameter = SIGMA
            s_marker = (points_per_unit * diameter) ** 2
        scat.set_sizes([s_marker] * N)

    if MODE == "ideal":
        box_label = "ИДЕАЛЬНЫЙ (МКТ)"
    else:
        box_label = "ИДЕАЛЬНЫЙ (ε=0)" if EPS <= 1e-6 else "РЕАЛЬНЫЙ (ЛД)"
    box_title.set_text(f"{box_label}   N={N}, L={fmt_val(L,conv_L,u_L())}")

    ax_maxw.cla()
    ax_maxw.set_title("Распределение скоростей", fontsize=10, color="#e8e8ec")
    vmax = max(M['mean_v'] * 3.0, 1.0)
    vel_k = VEL_FACTOR if USE_SI else 1.0  
    ax_maxw.hist(conv_VEL(v), bins=24, range=(0, conv_VEL(vmax)),
                 density=True, color="#10b981", alpha=0.55)
    T_curr = M["T"]
    if T_curr > 0:
        vv = np.linspace(0, vmax, 200)
        f_theo = (m / (kB * T_curr)) * vv * np.exp(-m * vv ** 2 / (2 * kB * T_curr))
        
        ax_maxw.plot(conv_VEL(vv), f_theo / vel_k, color="#3b82f6", lw=2.5)

    fmt_v = make_tick_formatter("м/с", area=False, ref_value=conv_VEL(vmax))
    ax_maxw.xaxis.set_major_formatter(fmt_v)
    ax_maxw.set_xlabel(f"Скорость |v|, {getattr(fmt_v.func,'unit',u_VEL())}")
    ax_maxw.set_ylabel("Плотность F(v)")

    press_hist.append(M["P_hits"])
    theory_hist.append(M["P_theory"])
    if len(press_hist) > 200:
        press_hist.pop(0); theory_hist.pop(0)

    if press_hist:
        xs = range(len(press_hist))
        line_p.set_data(xs, [conv_P(p) for p in press_hist])
        line_t.set_data(xs, [conv_P(p) for p in theory_hist])
        line_t.set_label("P Ван-дер-Ваальса" if MODE == "real" else "P по МКТ")
        ax_press.legend(fontsize=7, loc="upper right", framealpha=0.3)
        ax_press.set_xlim(0, max(50, len(press_hist)))
        recent = press_hist[-40:] + theory_hist[-40:]
        scale = np.median(recent) if recent else 1e-3
        ymax = conv_P(max(scale * 2.2, 1e-3))
        ax_press.set_ylim(0, ymax)

    if MODE == "real":
        S = M["S"]
        P_real = M["P_vdw"]
        vdw_pt.set_data([conv_S(S)], [conv_P(P_real)])
        vdw_trail_x.append(S); vdw_trail_y.append(P_real)
        if len(vdw_trail_x) > 60:
            vdw_trail_x.pop(0); vdw_trail_y.pop(0)
        vdw_trail.set_data([conv_S(s) for s in vdw_trail_x],
                           [conv_P(p) for p in vdw_trail_y])
        P_dyn = compute_isotherm(T_curr, S_space)
        dynamic_iso_line.set_data(conv_S(S_space), conv_P(P_dyn))
        dynamic_iso_line.set_visible(True)
    else:
        vdw_pt.set_data([], [])
        vdw_trail.set_data([], [])
        dynamic_iso_line.set_visible(False)

    S_now = M['S']
    NkT = N * kB * M['T']
    if MODE == "ideal":
        lhs = M['P_hits'] * S_now
        eq_calc.set_text(f"P·S = {fmt_val(lhs,conv_E,u_E())}   ≈   N·k·T = {fmt_val(NkT,conv_E,u_E())}")
        P_formula = NkT / S_now
        eq_pcalc.set_text(f"P = N·k·T/S = {fmt_val(P_formula,conv_P,u_P())}")
    elif EPS <= 1e-6:
        lhs = M['P_vdw'] * (S_now - N * B_VDW)
        eq_calc.set_text(f"P·(S−Nb) = {fmt_val(lhs,conv_E,u_E())}   ≈   N·k·T = {fmt_val(NkT,conv_E,u_E())}")
        P_formula = NkT / (S_now - N * B_VDW)
        eq_pcalc.set_text(f"P = N·k·T/(S−Nb) = {fmt_val(P_formula,conv_P,u_P())}")
    else:
        a_term = A_VDW * N**2 / S_now**2
        lhs = (M['P_vdw'] + a_term) * (S_now - N * B_VDW)
        eq_calc.set_text(f"(P+aN²/S²)(S−Nb) = {fmt_val(lhs,conv_E,u_E())}   ≈   N·k·T = {fmt_val(NkT,conv_E,u_E())}")
        P_formula = NkT / (S_now - N * B_VDW) - a_term
        eq_pcalc.set_text(f"P = N·k·T/(S−Nb) − a·N²/S² = {fmt_val(P_formula,conv_P,u_P())}")

    if MODE == "ideal":
        info = (
            f"ИДЕАЛЬНЫЙ ГАЗ\n"
            f"T = {fmt(M['T'],'T')}\n"
            f"P по ударам = {fmt(M['P_hits'],'P')}\n"
            f"P по МКТ    = {fmt(M['P_mkt'],'P')}"
        )
    else:
        if EPS <= 1e-6:
            info = (
                f"ИДЕАЛЬНЫЙ ГАЗ (ε = 0: жёсткие сферы, σ = {SIGMA})\n"
                f"T = {fmt(M['T'],'T')}   Площадь(S) = {fmt(M['S'],'S')}   ε = {EPS:.2f}\n"
                f"P по ударам = {fmt(M['P_hits'],'P')}    P Ван-дер-Ваальса = {fmt(M['P_vdw'],'P')}"
            )
        else:
            info = (
                f"РЕАЛЬНЫЙ ГАЗ (Молекулы малы: σ = {SIGMA})\n"
                f"T = {fmt(M['T'],'T')}   Площадь(S) = {fmt(M['S'],'S')}   ε = {EPS:.2f}\n"
                f"P по ударам = {fmt(M['P_hits'],'P')}    P Ван-дер-Ваальса = {fmt(M['P_vdw'],'P')}"
            )
    info_text.set_text(info)

    if USE_SI:
        units_note.set_text("единицы СИ (эталон — аргон: σ=3.40 Å, ε/k=120 К, m=39.95 а.е.м.)")
    else:
        units_note.set_text("приведённые единицы Леннард-Джонса (m=σ=ε₀=k=1)")

    return scat,

ani = FuncAnimation(fig, update, interval=25, blit=False, cache_frame_data=False, save_count=1)

if __name__ == "__main__":
    plt.show()
