def update(_):
    for _ in range(4): 
        gas.step()

    M = gas.measurements()

    scat.set_offsets(np.c_[gas.x, gas.y])
    v = np.sqrt(gas.vx ** 2 + gas.vy ** 2)
    t = np.clip(v / (V_MEAN * 2.0 if MODE=="ideal" else V_MEAN_REAL * 2.0), 0, 1)
    colors = np.zeros((N, 3))
    colors[:, 0] = 0.23 + 0.77 * t
    colors[:, 1] = 0.51 - 0.3 * np.abs(t - 0.5)
    colors[:, 2] = 0.96 - 0.8 * t
    colors = np.clip(colors + gas.flash[:, None] * 0.5, 0, 1)
    scat.set_color(colors)

    bbox = ax_box.get_window_extent()
    if bbox.width > 1:
        points_per_unit = (bbox.width / L) / (fig.dpi / 72.0)
        s_marker = (points_per_unit * (2.0 * RAD_IDEAL if MODE == "ideal" else SIGMA)) ** 2
        scat.set_sizes([s_marker] * N)

    box_title.set_text(f"{'ИДЕАЛЬНЫЙ (МКТ)' if MODE == 'ideal' else 'РЕАЛЬНЫЙ (ЛД)'}   N={N}, L={L:.1f}")

    ax_maxw.cla()
    ax_maxw.set_title("Распределение скоростей", fontsize=10, color="#e8e8ec")
    vmax = max(M['mean_v'] * 3.0, 1.0)
    ax_maxw.hist(v, bins=24, range=(0, vmax), density=True, color="#10b981", alpha=0.55)
    T_curr = M["T"]
    if T_curr > 0:
        vv = np.linspace(0, vmax, 200)
        f_theo = (m / (kB * T_curr)) * vv * np.exp(-m * vv ** 2 / (2 * kB * T_curr))
        ax_maxw.plot(vv, f_theo, color="#3b82f6", lw=2.5)

    press_hist.append(M["P_hits"])
    theory_hist.append(M["P_theory"])
    if len(press_hist) > 200:
        press_hist.pop(0); theory_hist.pop(0)
    
    if press_hist:
        xs = range(len(press_hist))
        line_p.set_data(xs, press_hist)
        line_t.set_data(xs, theory_hist)
        ax_press.set_xlim(0, max(50, len(press_hist)))
        ymax = max(max(press_hist + theory_hist, default=1e-3), 1e-3) * 1.3
        ax_press.set_ylim(0, ymax)

    if MODE == "real":
        S = M["S"]
        P_real = M["P_theory"]
        vdw_pt.set_data([S], [P_real])
        vdw_trail_x.append(S); vdw_trail_y.append(P_real)
        if len(vdw_trail_x) > 60:
            vdw_trail_x.pop(0); vdw_trail_y.pop(0)
        vdw_trail.set_data(vdw_trail_x, vdw_trail_y)
    else:
        vdw_pt.set_data([], [])
        vdw_trail.set_data([], [])

    if MODE == "ideal":
        info = (
            f"ИДЕАЛЬНЫЙ ГАЗ\n"
            f"Температура T = {M['T']:.3f}\n"
            f"P по ударам = {M['P_hits']:.4f}\n"
            f"P по МКТ    = {M['P_mkt']:.4f}\n"
            f"P·S ≈ N·k·T : {M['P_hits']*M['S']:.0f} ≈ {N*kB*M['T']:.0f}"
        )
    else:
        attract = "ВКЛ" if EPS > 1e-6 else "ВЫКЛ (газ жестких сфер)"
        info = (
            f"РЕАЛЬНЫЙ ГАЗ (Леннард-Джонс)\n"
            f"T = {M['T']:.3f}   Площадь(S) = {M['S']:.0f}   ε = {EPS:.2f}  притяжение: {attract}\n"
            f"P по ударам = {M['P_hits']:.4f}    P теория = {M['P_theory']:.4f}\n"
            
        )
    info_text.set_text(info)

    return scat,

