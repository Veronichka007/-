def iso_s_space():
    return np.linspace(S_MIN_PLOT, S_MAX_PLOT, 800)

def compute_isotherm(T_iso, S):
    b_tot = N * B_VDW
    denom = S - b_tot
    P = np.where(denom > 1e-3,
                 N * kB * T_iso / denom - A_VDW * (N**2) / (S**2),
                 np.nan)
    return P

