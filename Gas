PREFIXES = [
    (1e24, "Y"), (1e21, "Z"), (1e18, "E"), (1e15, "P"), (1e12, "T"),
    (1e9, "Г"), (1e6, "М"), (1e3, "к"), (1.0, ""),
    (1e-3, "м"), (1e-6, "мк"), (1e-9, "н"), (1e-12, "п"),
    (1e-15, "ф"), (1e-18, "а"), (1e-21, "з"), (1e-24, "и"),
]

def _pick_prefix(av):
    for scale, pref in PREFIXES:
        if av >= scale:
            return scale, pref
    return PREFIXES[-1]

def _fmt_num(x):
    ax = abs(x)
    if ax == 0:
        return "0"
    if ax >= 100:
        return f"{x:.0f}"
    if ax >= 10:
        return f"{x:.1f}"
    return f"{x:.2f}"

def fmt_si(value, conv, base_unit, area=False):
    """Форматирует число с метрической приставкой вместо записи 3.4e-10."""
    v = conv(value)
    if not USE_SI:
        return f"{v:.3f} {base_unit}"
    if v == 0:
        return f"0 {base_unit}"
    av = abs(v)
    if area:
        lin = np.sqrt(av)
        scale, pref = _pick_prefix(lin)
        num = v / (scale ** 2)
        return f"{_fmt_num(num)} {pref}{base_unit}"
    scale, pref = _pick_prefix(av)
    num = v / scale
    return f"{_fmt_num(num)} {pref}{base_unit}"

def make_tick_formatter(base_unit, area=False, ref_value=None):
    """FuncFormatter для оси: значения уже в СИ. Единая приставка по ref_value."""
    from matplotlib.ticker import FuncFormatter
    if not USE_SI:
        def _lj(v, pos):
            if v == 0:
                return "0"
            return f"{v:.0f}" if abs(v) >= 10 else f"{v:.2f}"
        _lj.unit = base_unit
        return FuncFormatter(_lj)
    if area:
        lin = np.sqrt(abs(ref_value)) if ref_value else 1.0
        scale, pref = _pick_prefix(lin)
        denom = scale ** 2
    else:
        scale, pref = _pick_prefix(abs(ref_value) if ref_value else 1.0)
        denom = scale
    unit = f"{pref}{base_unit}"
    def _f(v, pos):
        if v == 0:
            return "0"
        return f"{v/denom:.0f}" if abs(v/denom) >= 10 else f"{v/denom:.1f}"
    _f.unit = unit
    return FuncFormatter(_f)

def fmt_val(value, conv, unit):
    if conv is conv_S:
        return fmt_si(value, conv, "м²" if USE_SI else "(LJ)", area=True)
    if USE_SI:
        base = {id(conv_L): "м", id(conv_P): "Па", id(conv_E): "Дж",
                id(conv_VEL): "м/с", id(conv_T): "К"}.get(id(conv), unit)
    else:
        base = unit
    return fmt_si(value, conv, base, area=False)

def fmt(value, kind):
    if kind == "T": return fmt_si(value, conv_T, "К" if USE_SI else "(LJ)")
    if kind == "S": return fmt_si(value, conv_S, "м²" if USE_SI else "(LJ)", area=True)
    if kind == "P": return fmt_si(value, conv_P, "Па" if USE_SI else "(LJ)")
    return _fmt_num(value)

def lj_potential(r):
    sr6 = (SIGMA / r) ** 6
    return 4.0 * EPS * (sr6 * sr6 - sr6)

def compute_vdw_constants():
    b = 0.5 * np.pi * SIGMA ** 2
    r_min = 2.0 ** (1.0 / 6.0) * SIGMA
    r = np.linspace(r_min, RCUT, 20000)
    U = lj_potential(r)
    integrand = U * 2.0 * np.pi * r
    if hasattr(np, 'trapezoid'):
        a = -0.5 * np.trapezoid(integrand, r)
    else:
        a = -0.5 * np.trapz(integrand, r)
    return a, b

def update_vdw_constants():
    global A_VDW, B_VDW, V_C, T_C, P_C
    A_VDW, B_VDW = compute_vdw_constants()
    if A_VDW > 0.0 and B_VDW > 0.0:
        V_C = 2.0 * N * B_VDW
        T_C = 8.0 * A_VDW / (27.0 * B_VDW * kB)
        P_C = A_VDW / (27.0 * B_VDW ** 2)
    else:
        V_C = T_C = P_C = 0.0

A_VDW = B_VDW = V_C = T_C = P_C = 0.0
update_vdw_constants()

def maxwell_velocities(n, v_mean):
    sigma_v = v_mean / np.sqrt(np.pi / 2.0)
    vx = np.random.normal(0.0, sigma_v, n)
    vy = np.random.normal(0.0, sigma_v, n)
    return vx, vy

class GasSystem:
    def __init__(self):
        self.reset()

    def reset(self):
        global L, V_MEAN, V_MEAN_REAL
        cols = int(np.ceil(np.sqrt(N)))
        cell = (L - 0.6) / cols
        xs, ys = [], []
        for i in range(cols):
            for j in range(cols):
                if len(xs) >= N: break
                xs.append(0.3 + cell * (i + 0.5))
                ys.append(0.3 + cell * (j + 0.5))
        
        rad = RAD_IDEAL if MODE == "ideal" else SIGMA * 0.5
        self.x = np.clip(np.array(xs[:N]), rad, L - rad)
        self.y = np.clip(np.array(ys[:N]), rad, L - rad)

        if MODE == "ideal":
            ang = np.random.uniform(0, 2 * np.pi, N)
            self.vx = V_MEAN * np.cos(ang)
            self.vy = V_MEAN * np.sin(ang)
        else:
            self.vx, self.vy = maxwell_velocities(N, V_MEAN_REAL)

        self.fx = np.zeros(N)
        self.fy = np.zeros(N)
        self.flash = np.zeros(N)
        self.reset_measurements()

        if MODE == "real":
            self.compute_forces_lj()

        warm = 400
        for _ in range(warm):
            self.step()
        self.reset_measurements()

    def reset_measurements(self):
        self.wall_impulse = 0.0
        self.wall_hits = 0
        self.meas_time = 0.0
        self.virial_sum = 0.0
        self.virial_steps = 0

    def compute_forces_lj(self):
        self.fx[:] = 0.0
        self.fy[:] = 0.0
        rc2 = RCUT * RCUT
        dx = self.x[:, None] - self.x[None, :]
        dy = self.y[:, None] - self.y[None, :]
        r2 = dx * dx + dy * dy
        iu = np.triu_indices(N, k=1)
        dx, dy, r2 = dx[iu], dy[iu], r2[iu]
        mask = (r2 < rc2) & (r2 > 1e-7)
        dx, dy, r2 = dx[mask], dy[mask], r2[mask]
        if r2.size == 0: return 0.0

        inv2 = (SIGMA * SIGMA) / r2
        inv6 = inv2 ** 3
        inv12 = inv6 ** 2
        f_over_r = 24.0 * EPS * (2.0 * inv12 - inv6) / r2
        fx = f_over_r * dx
        fy = f_over_r * dy
        ii, jj = iu[0][mask], iu[1][mask]
        np.add.at(self.fx, ii, fx)
        np.add.at(self.fy, ii, fy)
        np.add.at(self.fx, jj, -fx)
        np.add.at(self.fy, jj, -fy)
        return np.sum(f_over_r * r2)

    def elastic_collisions(self):
        rad = RAD_IDEAL if MODE == "ideal" else SIGMA * 0.5
        d = 2.0 * rad
        d2 = d * d
        dx = self.x[:, None] - self.x[None, :]
        dy = self.y[:, None] - self.y[None, :]
        r2 = dx * dx + dy * dy
        iu = np.triu_indices(N, k=1)
        idx = np.where((r2[iu] < d2) & (r2[iu] > 1e-9))[0]
        
        collision_virial = 0.0
        for k in idx:
            i, j = iu[0][k], iu[1][k]
            rx, ry = self.x[i] - self.x[j], self.y[i] - self.y[j]
            r = np.hypot(rx, ry)
            if r < 1e-9: continue
            nx, ny = rx / r, ry / r
            dvx, dvy = self.vx[i] - self.vx[j], self.vy[i] - self.vy[j]
            vn = dvx * nx + dvy * ny
            if vn > 0: continue
            
            if MODE == "real":
                collision_virial += -m * vn * r
                
            self.vx[i] -= vn * nx; self.vy[i] -= vn * ny
            self.vx[j] += vn * nx; self.vy[j] += vn * ny
            overlap = (d - r) / 2.0
            self.x[i] += nx * overlap; self.y[i] += ny * overlap
            self.x[j] -= nx * overlap; self.y[j] -= ny * overlap
            
        if MODE == "real" and idx.size > 0:
            self.virial_sum += collision_virial / DT

    def handle_walls(self, rad):
        mask = self.x < rad
        self.wall_impulse += np.sum(2.0 * m * np.abs(self.vx[mask]))
        self.wall_hits += np.count_nonzero(mask)
        self.x[mask] = rad; self.vx[mask] = np.abs(self.vx[mask]); self.flash[mask] = 1.0
        
        mask = self.x > L - rad
        self.wall_impulse += np.sum(2.0 * m * np.abs(self.vx[mask]))
        self.wall_hits += np.count_nonzero(mask)
        self.x[mask] = L - rad; self.vx[mask] = -np.abs(self.vx[mask]); self.flash[mask] = 1.0
        
        mask = self.y < rad
        self.wall_impulse += np.sum(2.0 * m * np.abs(self.vy[mask]))
        self.wall_hits += np.count_nonzero(mask)
        self.y[mask] = rad; self.vy[mask] = np.abs(self.vy[mask]); self.flash[mask] = 1.0
        
        mask = self.y > L - rad
        self.wall_impulse += np.sum(2.0 * m * np.abs(self.vy[mask]))
        self.wall_hits += np.count_nonzero(mask)
        self.y[mask] = L - rad; self.vy[mask] = -np.abs(self.vy[mask]); self.flash[mask] = 1.0

    def step(self):
        self.flash *= 0.85
        rad = RAD_IDEAL if MODE == "ideal" else SIGMA * 0.5
        
        if MODE == "ideal":
            self.x += self.vx * DT
            self.y += self.vy * DT
            self.handle_walls(rad)
            self.elastic_collisions()
        else:
            self.vx += 0.5 * DT * self.fx / m
            self.vy += 0.5 * DT * self.fy / m
            self.x += self.vx * DT
            self.y += self.vy * DT
            
            self.handle_walls(rad)
            self.elastic_collisions()
            
            vir = self.compute_forces_lj()
            
            self.vx += 0.5 * DT * self.fx / m
            self.vy += 0.5 * DT * self.fy / m
            
            self.virial_sum += vir
            self.virial_steps += 1
            
        self.meas_time += DT

    def measurements(self):
        S = L * L
        v2 = self.vx ** 2 + self.vy ** 2
        mean_v2 = np.mean(v2)
        mean_v = np.mean(np.sqrt(v2))
        T = m * mean_v2 / (DIM * kB)
        perimeter = 4.0 * L
        P_hits = self.wall_impulse / (perimeter * self.meas_time) if self.meas_time > 0 else 0.0
        hit_rate = self.wall_hits / self.meas_time if self.meas_time > 0 else 0.0
        P_mkt = N * m * mean_v2 / (DIM * S)
        if MODE == "real":
            denom = S - N * B_VDW
            if denom > 1e-6:
                P_vdw = N * kB * T / denom - A_VDW * (N ** 2) / (S ** 2)
            else:
                P_vdw = N * kB * T / S - A_VDW * (N ** 2) / (S ** 2)
            P_kin = N * kB * T / S
            P_theory = P_vdw
        else:
            P_kin = P_mkt
            P_vdw = P_mkt
            P_theory = P_mkt
        return dict(S=S, T=T, mean_v=mean_v, mean_v2=mean_v2, P_hits=P_hits, hit_rate=hit_rate,
                    P_mkt=P_mkt, P_kin=P_kin, P_vdw=P_vdw, P_theory=P_theory)

